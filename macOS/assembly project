
.text
.p2align 2
.globl _main
_main:
    // Check that we have exactly 2 arguments
    cmp x0, #2
    bne error

    // Get the filename
    ldr x0, [x1, #8]

    // Open the file for reading
    mov x1, #0
    mov x16, #5
    svc #0x80

    // Check whether open failed
    cmp x0, #0
    blt error

    // Save the file descriptor
    mov x20, x0

    // Allocate 16 bytes of stack space
    sub sp, sp, #16

loop:
    // Set up arguments for read
    mov x0, x20
    mov x1, sp
    mov x2, #1

    // Read one character
    mov x16, #3
    svc #0x80

    // Check the read result
    cmp x0, #0
    beq done
    blt error
    // Set up arguments for write
    mov x0, #1
    mov x1, sp
    mov x2, #1
    // Write one character
    mov x16, #4
    svc #0x80
    // Check the write result
    cmp x0, #1
    bne error
    // Repeat the loop
    b loop
done:
    // Exit successfully
    mov x0, #0
    mov x16, #1
    svc #0x80
error:
    // Exit with an error
    mov x0, #1
    mov x16, #1
    svc #0x80
